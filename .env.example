# === Telegram Bot ===
# Create a bot via @BotFather on Telegram, then paste the token here.
TELEGRAM_BOT_TOKEN=123456789:AAAA-your-bot-token-here

# Your Telegram chat ID (where notifications are sent).
# To find it: message your bot, then visit
# https://api.telegram.org/bot<TOKEN>/getUpdates and look for "chat":{"id":...}
TELEGRAM_CHAT_ID=123456789

# === CORS ===
# Comma-separated list of allowed browser origins (the deployed app URLs).
# Use * only for local testing.
ALLOWED_ORIGINS=https://patentechi.it,https://www.patentechi.it

# === Notifications ===
# Seconds to wait between "new session" Telegram pings (avoids spam).
# Set to 0 to notify on every session start.
NOTIFY_COOLDOWN_SECONDS=300

# Send a Telegram message when a session ends (true/false).
NOTIFY_ON_SESSION_END=false

# === Sessions ===
# A session is considered active if seen within this many seconds.
SESSION_TIMEOUT_SECONDS=90

# === Server ===
HOST=127.0.0.1
PORT=8000

# Path to the SQLite database file.
DB_PATH=data/analytics.db
